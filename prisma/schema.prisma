generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  pin       String?  // hashed 4-digit PIN
  avatar    String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  picks         Pick[]
  pointsHistory PointsHistory[]
}

model Tournament {
  id        String   @id @default(cuid())
  name      String   // "Mundial 2026", "Eurocopa 2028"
  slug      String   @unique
  year      Int
  isActive  Boolean  @default(false)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  teams   Team[]
  matches Match[]
  tiers   Tier[]
}

model Tier {
  id           String @id @default(cuid())
  number       Int    // 1, 2, 3, 4
  label        String // "Favoritos", "Fuertes", etc.
  maxPicks     Int    // 1, 2, 3, 4
  multiplier   Float  // 1.0, 1.5, 2.5, 4.0

  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String

  teams Team[]
  picks Pick[]

  @@unique([tournamentId, number])
}

model Team {
  id           String  @id @default(cuid())
  name         String
  code         String  // "ESP", "BRA"
  flagEmoji    String
  flagUrl      String?
  group        String? // "A", "B", "C"...
  confederation String? // "UEFA", "CONMEBOL"...
  eliminated   Boolean @default(false)
  finalPosition String? // "Champion", "Runner-up", "SF", "QF", "R16", "Group"

  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String
  tier         Tier       @relation(fields: [tierId], references: [id])
  tierId       String

  picks      Pick[]
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
}

model Pick {
  id     String @id @default(cuid())
  userId String
  teamId String
  tierId String

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])
  tier Tier @relation(fields: [tierId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@unique([userId, tierId, teamId])
}

model Match {
  id           String      @id @default(cuid())
  matchNumber  Int
  round        MatchRound
  group        String?
  scheduledAt  DateTime
  venue        String?
  status       MatchStatus @default(SCHEDULED)

  homeTeamId String?
  awayTeamId String?
  homeTeam   Team?   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team?   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  homeScore Int?
  awayScore Int?
  homePenalties Int?
  awayPenalties Int?

  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String

  pointsHistory PointsHistory[]
}

model PointsHistory {
  id        String   @id @default(cuid())
  userId    String
  matchId   String?
  reason    String   // "WIN", "DRAW", "R16", "QF", "SF", "FINAL", "CHAMPION"
  teamCode  String
  points    Float
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  match Match? @relation(fields: [matchId], references: [id])
}

enum MatchRound {
  GROUP
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
}
